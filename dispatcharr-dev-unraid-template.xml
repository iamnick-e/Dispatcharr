<?xml version="1.0"?>
<Container version="2">
  <Name>Dispatcharr-Dev</Name>
  <Repository>ghcr.io/dispatcharr/dispatcharr:latest</Repository>
  <Registry>https://ghcr.io/dispatcharr/dispatcharr</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/Dispatcharr/Dispatcharr/issues</Support>
  <Project>https://github.com/Dispatcharr/Dispatcharr</Project>
  <Overview>Dispatcharr Development Instance - IPTV Proxy with HDHomeRun Emulation for Plex/Jellyfin. This is a separate development/testing instance that runs alongside your production Dispatcharr.</Overview>
  <Category>MediaApp:Video Status:Beta</Category>
  <WebUI>http://[IP]:[PORT:9192]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/Dispatcharr/Dispatcharr/main/frontend/public/logo.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>PostgreSQL Dev, Redis Dev (see description for setup)</Requires>
  <Config Name="Web UI Port" Target="9191" Default="9192" Mode="tcp" Description="Web interface port (changed to 9192 to avoid conflict with production)" Type="Port" Display="always" Required="true" Mask="false">9192</Config>
  <Config Name="App Data" Target="/data" Default="/mnt/user/appdata/dispatcharr-dev/data" Mode="rw" Description="Application data directory" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/dispatcharr-dev/data</Config>
  <Config Name="Environment" Target="DISPATCHARR_ENV" Default="modular" Mode="" Description="Dispatcharr environment mode" Type="Variable" Display="advanced" Required="true" Mask="false">modular</Config>
  <Config Name="Secret Key" Target="SECRET_KEY" Default="" Mode="" Description="Django secret key (generate a random string)" Type="Variable" Display="always" Required="true" Mask="true">3hYXQO6XjLqAK7zu4BlsZ5tjqm2/Me17FV3NwDT7UcgcAjpAkb0ZXNuUD7W1abnYnno=</Config>
  <Config Name="Database Host" Target="POSTGRES_HOST" Default="dispatcharr-db-dev" Mode="" Description="PostgreSQL hostname (use container name if using custom network)" Type="Variable" Display="always" Required="true" Mask="false">dispatcharr-db-dev</Config>
  <Config Name="Database Port" Target="POSTGRES_PORT" Default="5432" Mode="" Description="PostgreSQL port (internal)" Type="Variable" Display="advanced" Required="true" Mask="false">5432</Config>
  <Config Name="Database Name" Target="POSTGRES_DB" Default="dispatcharr_dev" Mode="" Description="Database name" Type="Variable" Display="advanced" Required="true" Mask="false">dispatcharr_dev</Config>
  <Config Name="Database User" Target="POSTGRES_USER" Default="dispatch_dev" Mode="" Description="Database username" Type="Variable" Display="advanced" Required="true" Mask="false">dispatch_dev</Config>
  <Config Name="Database Password" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="Database password" Type="Variable" Display="always" Required="true" Mask="true">dev_secret_2026</Config>
  <Config Name="Redis Host" Target="REDIS_HOST" Default="dispatcharr-redis-dev" Mode="" Description="Redis hostname (use container name if using custom network)" Type="Variable" Display="always" Required="true" Mask="false">dispatcharr-redis-dev</Config>
  <Config Name="Redis Port" Target="REDIS_PORT" Default="6379" Mode="" Description="Redis port (internal)" Type="Variable" Display="advanced" Required="true" Mask="false">6379</Config>
  <Config Name="Log Level" Target="DISPATCHARR_LOG_LEVEL" Default="debug" Mode="" Description="Logging verbosity (debug for dev instance)" Type="Variable" Display="advanced" Required="false" Mask="false">debug</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="advanced-hide" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="advanced-hide" Required="true" Mask="false">100</Config>
</Container>
